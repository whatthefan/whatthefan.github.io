[
 {
  "t0": 0.0,
  "t1": 0.24,
  "text": "[Música"
 },
 {
  "t0": 1.12,
  "t1": 1.88,
  "text": "¿Veis esto"
 },
 {
  "t0": 2.69,
  "t1": 5.46,
  "text": "hace que tus clientes te dejen la reseña en menos de 10 segundos."
 },
 {
  "t0": 6.05,
  "t1": 6.8,
  "text": "Me llamo Juan"
 },
 {
  "t0": 7.25,
  "t1": 7.85,
  "text": "y tengo pliz"
 },
 {
  "t0": 8.3,
  "t1": 10.76,
  "text": "hacemos placas para restaurantes, bares"
 },
 {
  "t0": 10.76,
  "t1": 11.7,
  "text": "y comercios locales"
 },
 {
  "t0": 12.17,
  "t1": 13.64,
  "text": "Tus clientes salen contentos."
 },
 {
  "t0": 14.04,
  "t1": 15.02,
  "text": "Pero nadie te escribe."
 },
 {
  "t0": 15.52,
  "t1": 16.32,
  "text": "y no es que no quier"
 },
 {
  "t0": 16.79,
  "t1": 18.74,
  "text": "es que si les olvido les da pereza bus"
 },
 {
  "t0": 19.45,
  "t1": 20.47,
  "text": "con la placa en la mesa"
 },
 {
  "t0": 20.88,
  "t1": 22.34,
  "text": "solo tienen que acercar el móvil"
 },
 {
  "t0": 22.74,
  "t1": 23.31,
  "text": "y boom"
 },
 {
  "t0": 23.98,
  "t1": 24.73,
  "text": "ya se abre"
 },
 {
  "t0": 25.23,
  "t1": 28.77,
  "text": "¿Qué es lo que se abre? Las ganas de tu cliente dejarte la reseña."
 },
 {
  "t0": 29.21,
  "t1": 29.65,
  "text": "¿Por qué"
 },
 {
  "t0": 30.02,
  "t1": 31.36,
  "text": "porque no tienen que des..."
 },
 {
  "t0": 31.36,
  "t1": 33.71,
  "text": "cargar nada ni tener una app"
 },
 {
  "t0": 33.71,
  "t1": 35.07,
  "text": "ni tener que buscarte."
 },
 {
  "t0": 35.07,
  "t1": 36.77,
  "text": "y si alguien tiene un móvil antiguo"
 },
 {
  "t0": 37.24,
  "t1": 38.79,
  "text": "tenemos el QR también."
 },
 {
  "t0": 38.79,
  "t1": 41.39,
  "text": "¿Y por qué nosotros? Pues por tres simples motivos."
 },
 {
  "t0": 41.39,
  "t1": 43.61,
  "text": "la diseñamos con tu logo y tus colores."
 },
 {
  "t0": 43.61,
  "t1": 44.86,
  "text": "el diseño es gratis"
 },
 {
  "t0": 44.86,
  "t1": 46.15,
  "text": "y no se imprime nada"
 },
 {
  "t0": 46.15,
  "t1": 48.28,
  "text": "hasta que te guste. Esto lo hablamos."
 },
 {
  "t0": 48.28,
  "t1": 49.62,
  "text": "y hasta que no salga nada."
 },
 {
  "t0": 49.62,
  "t1": 51.26,
  "text": "no te mandamos una placa ella"
 },
 {
  "t0": 51.26,
  "t1": 52.63,
  "text": "Te enseñamos a ti, a tu"
 },
 {
  "t0": 52.63,
  "t1": 53.49,
  "text": "¿Cuándo y"
 },
 {
  "t0": 54.37,
  "t1": 54.82,
  "text": "pedirla"
 },
 {
  "t0": 55.34,
  "t1": 57.1,
  "text": "y es lo que de verdad marca la diferencia."
 },
 {
  "t0": 57.1,
  "t1": 59.93,
  "text": "Las placas con pago único. Las pagues una vez."
 },
 {
  "t0": 59.93,
