{
  "name": "plea5e-web",
  "private": true,
  "description": "La web de PLEA5E. Las paginas de public/ son HTML suelto y no necesitan nada; las dependencias son para el Worker de src/ y para montar el generador de placas.",
  "scripts": {
    "deploy": "wrangler deploy",
    "generador": "python3 gen/construye.py",
    "sitemap": "python3 gen/sitemap.py",
    "reputacion": "node reputacion/analiza.mjs",
    "prueba-reputacion": "node --test reputacion/prueba.mjs src/lib/prueba.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "devDependencies": {
    "qrcode-generator": "^1.4.4",
    "wrangler": "^4.0.0"
  }
}
