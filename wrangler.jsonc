{
  // La configuracion del Worker. Cloudflare la lee al desplegar; no hay
  // que tocar nada en el panel salvo las variables y el almacen.
  "$schema": "node_modules/wrangler/config-schema.json",

  // El nombre TIENE que ser el mismo que el del Worker que ya existe en
  // el panel. Cloudflare lo bautizo con el nombre del repositorio al
  // conectarlo, y un Worker no se puede renombrar. Si aqui pusiera otra
  // cosa, un despliegue hecho desde el ordenador crearia un SEGUNDO
  // Worker con ese otro nombre y tendriamos dos webs distintas vivas.
  // El nombre no lo ve nadie: el publico entra por plea5e.es.
  "name": "whatthefan-github-io",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Lo pide la libreria de Anthropic, que usa piezas de Node. Sin esto,
  // la IA no arranca (y los colores los pondria la tabla, que tampoco
  // seria un drama, pero mejor que funcione).
  "compatibility_flags": ["nodejs_compat"],

  // La web entera. Todo lo que no sea /api/... sale de aqui, servido por
  // Cloudflare desde el sitio mas cercano al cliente.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // El almacen de pedidos. El identificador es el del KV que se llama
  // "encargos-plea5e" en Storage & Databases. No es un secreto: es solo
  // la direccion del cajon, y sin la cuenta no abre nada.
  //
  // ENCARGOS es el nombre con el que lo llama el codigo (src/api/*.js).
  // Ese nombre no se toca aunque el cajon se llame de otra forma.
  "kv_namespaces": [
    { "binding": "ENCARGOS", "id": "22d3750e7f964c08ac98843119f1201c" }
  ],

  "observability": { "enabled": true }
}
