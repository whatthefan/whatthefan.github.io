{
  // La configuracion del Worker. Cloudflare la lee al desplegar; no hay
  // que tocar nada en el panel salvo las variables y el almacen.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plea5e",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Lo pide la libreria de Anthropic, que usa piezas de Node. Sin esto,
  // la IA no arranca (y los colores los pondria la tabla, que tampoco
  // seria un drama, pero mejor que funcione).
  "compatibility_flags": ["nodejs_compat"],

  // La web entera. Todo lo que no sea /api/... sale de aqui, servido por
  // Cloudflare desde el sitio mas cercano al cliente.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // El almacen de pedidos. Ya existe en Cloudflare con el nombre
  // "encargos-plea5e"; este es su identificador. Aqui es donde se guarda
  // cada encargo que entra por la web, y de aqui los lee el panel de
  // /taller/pedidos.html.
  //
  // Sin esta linea el Worker no encuentra el almacen y el pedido se
  // pierde: por eso el panel salia vacio.
  "kv_namespaces": [
    { "binding": "ENCARGOS", "id": "22d3750e7f964c08ac98843119f1201c" }
  ],

  "observability": { "enabled": true }
}
